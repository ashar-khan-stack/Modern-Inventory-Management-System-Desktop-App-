<UserControl x:Class="ModernInventory.Desktop.Presentation.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:ModernInventory.Desktop.Presentation.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BooleanToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True" />
        <conv:CurrencyFormatConverter x:Key="CurrencyFormat" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Metric Cards -->
            <RowDefinition Height="Auto" />
            <!-- Search & Actions Bar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Metric Summary Cards -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Total Customers -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="TOTAL REGISTERED CUSTOMERS" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="{Binding TotalCustomersCount}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Total Outstanding Receivables -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,8,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="TOTAL OUTSTANDING RECEIVABLES (KHATA)" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="{Binding TotalReceivables, Converter={StaticResource CurrencyFormat}}" Foreground="#F87171" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Active Status -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="LEDGER STATUS" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="Active &amp; Multi-Tenant Isolated" Foreground="#34D399" FontSize="16" FontWeight="Bold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Search & Actions Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Customer Directory &amp; Receivables" Foreground="White" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Customer ledger, credit limits &amp; outstanding balances" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                </StackPanel>

                <!-- Center Search Filter -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox Width="280" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBoxStyle}" Tag="Search Name, Phone, Company, CNIC..." />
                    <Button Content="Filter" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Padding="12,6" />
                    <Button Content="Clear" Command="{Binding ClearSearchCommand}" Background="#334155" Foreground="White" Margin="6,0,0,0" Padding="10,6" BorderThickness="0" Cursor="Hand" />
                </StackPanel>

                <!-- Right Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 Refresh" Command="{Binding RefreshCommand}" Background="#334155" Foreground="White" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                    <Button Content="+ Add Customer" Command="{Binding OpenAddCustomerCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Main DataGrid & Side Drawer -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Table Container -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Notifications -->
                    <StackPanel Grid.Row="0">
                        <Border Background="#064E3B" Padding="12,8" Margin="8,8,8,0" CornerRadius="4"
                                Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVis}}">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#A7F3D0" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                        <Border Background="#7F1D1D" Padding="12,8" Margin="8,8,8,0" CornerRadius="4"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVis}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FECACA" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                    </StackPanel>

                    <!-- Customers DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" RowBackground="#1E293B" AlternatingRowBackground="#0F172A"
                              Foreground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                              HeadersVisibility="Column" ColumnHeaderHeight="38" RowHeight="42" Margin="8">
                        
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#111827" />
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#334155" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Customer Name" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold" Foreground="White" />
                            <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="1.5*" Foreground="{StaticResource TextMutedBrush}" />
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="1.3*" Foreground="#38BDF8" />
                            <DataGridTextColumn Header="CNIC" Binding="{Binding Cnic}" Width="1.4*" Foreground="#CBD5E1" />
                            <DataGridTextColumn Header="Credit Limit" Binding="{Binding CreditLimit, Converter={StaticResource CurrencyFormat}}" Width="1.2*" Foreground="{StaticResource TextMutedBrush}" />
                            <DataGridTextColumn Header="Balance (Khata)" Binding="{Binding CurrentBalance, Converter={StaticResource CurrencyFormat}}" Width="1.4*" FontWeight="Bold" Foreground="#F87171" />
                            <DataGridTextColumn Header="Invoices" Binding="{Binding InvoicesCount}" Width="0.8*" Foreground="White" />
                            <DataGridTextColumn Header="Total Purchases" Binding="{Binding TotalPurchasedAmount, Converter={StaticResource CurrencyFormat}}" Width="1.4*" Foreground="#34D399" />

                            <!-- Action Column -->
                            <DataGridTemplateColumn Header="Actions" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Ledger" Command="{Binding DataContext.ViewCustomerHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Background="#1E3A8A" Foreground="White" Padding="6,4" Margin="2,0" BorderThickness="0" FontSize="11" Cursor="Hand" />
                                            <Button Content="Edit" Command="{Binding DataContext.OpenEditCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Background="#0284C7" Foreground="White" Padding="6,4" Margin="2,0" BorderThickness="0" FontSize="11" Cursor="Hand" />
                                            <Button Content="Delete" Command="{Binding DataContext.DeleteCustomerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Background="#DC2626" Foreground="White" Padding="6,4" Margin="2,0" BorderThickness="0" FontSize="11" Cursor="Hand" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Side Drawer for Customer Add / Edit -->
            <Border Grid.Column="1" Width="360" Margin="16,0,0,0" Style="{StaticResource CardBorderStyle}"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="{Binding EditorTitle}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Content="✕" Command="{Binding CloseDrawerCommand}" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0" FontSize="14" Cursor="Hand" />
                        </Grid>

                        <!-- Error in Editor -->
                        <Border Background="#7F1D1D" Padding="10,6" Margin="0,0,0,12" CornerRadius="4"
                                Visibility="{Binding EditorErrorMessage, Converter={StaticResource StringNotEmptyToVis}}">
                            <TextBlock Text="{Binding EditorErrorMessage}" Foreground="#FECACA" FontSize="11" TextWrapping="Wrap" />
                        </Border>

                        <!-- Full Name -->
                        <TextBlock Text="Customer Name *" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                        <!-- Company Name -->
                        <TextBlock Text="Company / Store Name" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormCompanyName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                        <!-- Phone -->
                        <TextBlock Text="Phone Number" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                        <!-- Email -->
                        <TextBlock Text="Email Address" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                        <!-- CNIC -->
                        <TextBlock Text="CNIC Number (e.g. 42101-1234567-1)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormCnic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                        <!-- NTN -->
                        <TextBlock Text="NTN (Tax Number)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormNtn, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                        <!-- Address -->
                        <TextBlock Text="Full Address / City" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                        <!-- Credit Limit -->
                        <TextBlock Text="Credit Limit (PKR)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormCreditLimit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                        <!-- Opening Balance (Only shown in Add mode) -->
                        <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource InvertedBoolToVis}}">
                            <TextBlock Text="Opening Receivable Balance (PKR)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FormOpeningBalance, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16" />
                        </StackPanel>

                        <!-- Buttons -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Cancel" Command="{Binding CloseDrawerCommand}" Background="#334155" Foreground="White" Margin="0,0,6,0" Padding="12,10" BorderThickness="0" Cursor="Hand" />
                            <Button Grid.Column="1" Content="Save Customer" Command="{Binding SaveCustomerCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 4. Customer History / Ledger Modal -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Background="#AA000000"
              Visibility="{Binding IsHistoryModalOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="700" Height="500" Style="{StaticResource CardBorderStyle}" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Modal Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedCustomer.Name, StringFormat='{}Customer Ledger &amp; Invoices — {0}'}" Foreground="White" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="{Binding SelectedCustomer.CurrentBalance, Converter={StaticResource CurrencyFormat}, StringFormat='{}Outstanding Balance: {0}'}" Foreground="#F87171" FontWeight="SemiBold" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Content="✕" Command="{Binding CloseHistoryModalCommand}" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0" FontSize="16" Cursor="Hand" />
                    </Grid>

                    <!-- History DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CustomerHistory}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="#0F172A" BorderThickness="1" BorderBrush="#334155" RowBackground="#1E293B" AlternatingRowBackground="#0F172A"
                              Foreground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                              HeadersVisibility="Column" ColumnHeaderHeight="34" RowHeight="36">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="1.3*" Foreground="{StaticResource TextMutedBrush}" />
                            <DataGridTextColumn Header="Invoice #" Binding="{Binding ReferenceNumber}" Width="1.2*" Foreground="#38BDF8" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Payment Method" Binding="{Binding PaymentMethod}" Width="1.1*" Foreground="#CBD5E1" />
                            <DataGridTextColumn Header="Grand Total" Binding="{Binding Amount, Converter={StaticResource CurrencyFormat}}" Width="1.2*" Foreground="White" />
                            <DataGridTextColumn Header="Paid" Binding="{Binding Paid, Converter={StaticResource CurrencyFormat}}" Width="1.1*" Foreground="#34D399" />
                            <DataGridTextColumn Header="Due Balance" Binding="{Binding DueBalance, Converter={StaticResource CurrencyFormat}}" Width="1.2*" Foreground="#F87171" FontWeight="Bold" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Modal Footer -->
                    <Button Grid.Row="2" Content="Close Ledger" Command="{Binding CloseHistoryModalCommand}" Background="#334155" Foreground="White" Padding="16,8" HorizontalAlignment="Right" Margin="0,16,0,0" BorderThickness="0" Cursor="Hand" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
