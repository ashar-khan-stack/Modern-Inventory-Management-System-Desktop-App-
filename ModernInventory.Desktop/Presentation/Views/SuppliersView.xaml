<UserControl x:Class="ModernInventory.Desktop.Presentation.Views.SuppliersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:ModernInventory.Desktop.Presentation.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BooleanToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True" />
        <conv:CurrencyFormatConverter x:Key="CurrencyFormat" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Metric Summary Cards -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="TOTAL REGISTERED SUPPLIERS" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="{Binding TotalSuppliersCount}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,8,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="TOTAL PAYABLE BALANCES" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="{Binding TotalPayables, Converter={StaticResource CurrencyFormat}}" Foreground="#F87171" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="LEDGER STATUS" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="Active &amp; Multi-Tenant Isolated" Foreground="#34D399" FontSize="16" FontWeight="Bold" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Search & Actions Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Supplier Directory &amp; Payables" Foreground="White" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Supplier ledger &amp; outstanding payable balances" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox Width="280" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBoxStyle}" Tag="Search Name, Company, Phone..." />
                    <Button Content="Filter" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Padding="12,6" />
                    <Button Content="Clear" Command="{Binding ClearSearchCommand}" Background="#334155" Foreground="White" Margin="6,0,0,0" Padding="10,6" BorderThickness="0" Cursor="Hand" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 Refresh" Command="{Binding RefreshCommand}" Background="#334155" Foreground="White" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                    <Button Content="+ Add Supplier" Command="{Binding OpenAddSupplierCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main DataGrid & Side Drawer -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Border Background="#064E3B" Padding="12,8" Margin="8,8,8,0" CornerRadius="4"
                                Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVis}}">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#A7F3D0" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                        <Border Background="#7F1D1D" Padding="12,8" Margin="8,8,8,0" CornerRadius="4"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVis}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FECACA" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" RowBackground="#1E293B" AlternatingRowBackground="#0F172A"
                              Foreground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                              HeadersVisibility="Column" ColumnHeaderHeight="38" RowHeight="42" Margin="8">
                        
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#111827" />
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#334155" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Supplier Name" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold" Foreground="White" />
                            <DataGridTextColumn Header="Company" Binding="{Binding CompanyName}" Width="1.5*" Foreground="{StaticResource TextMutedBrush}" />
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="1.3*" Foreground="#38BDF8" />
                            <DataGridTextColumn Header="Balance (Payable)" Binding="{Binding CurrentPayableBalance, Converter={StaticResource CurrencyFormat}}" Width="1.4*" FontWeight="Bold" Foreground="#F87171" />

                            <DataGridTemplateColumn Header="Actions" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Edit" Command="{Binding DataContext.OpenEditSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Background="#0284C7" Foreground="White" Padding="6,4" Margin="2,0" BorderThickness="0" FontSize="11" Cursor="Hand" />
                                            <Button Content="Delete" Command="{Binding DataContext.DeleteSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Background="#DC2626" Foreground="White" Padding="6,4" Margin="2,0" BorderThickness="0" FontSize="11" Cursor="Hand" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Side Drawer -->
            <Border Grid.Column="1" Width="360" Margin="16,0,0,0" Style="{StaticResource CardBorderStyle}"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="{Binding EditorTitle}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Content="✕" Command="{Binding CloseDrawerCommand}" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0" FontSize="14" Cursor="Hand" />
                        </Grid>

                        <Border Background="#7F1D1D" Padding="10,6" Margin="0,0,0,12" CornerRadius="4"
                                Visibility="{Binding EditorErrorMessage, Converter={StaticResource StringNotEmptyToVis}}">
                            <TextBlock Text="{Binding EditorErrorMessage}" Foreground="#FECACA" FontSize="11" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="Supplier Name *" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                        <TextBlock Text="Company Name" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormCompanyName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                        <TextBlock Text="Phone" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                        <TextBlock Text="Email" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                        <TextBlock Text="Address" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                        <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource InvertedBoolToVis}}">
                            <TextBlock Text="Opening Payable Balance (PKR)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FormOpeningBalance, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16" />
                        </StackPanel>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Cancel" Command="{Binding CloseDrawerCommand}" Background="#334155" Foreground="White" Margin="0,0,6,0" Padding="12,10" BorderThickness="0" Cursor="Hand" />
                            <Button Grid.Column="1" Content="Save Supplier" Command="{Binding SaveSupplierCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
