<UserControl x:Class="ModernInventory.Desktop.Presentation.Views.StockAdjustmentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:ModernInventory.Desktop.Presentation.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:CurrencyFormatConverter x:Key="CurrencyFormat" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Stock Adjustment &amp; Audit" Foreground="White" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Atomic inventory reconciliation for additions, damage, loss, and audits" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📜 View Movement History" Command="{Binding ViewHistoryCommand}" Background="#334155" Foreground="White" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Form & Live Preview Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Adjustment Form -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,16,0" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Status / Error Messages -->
                        <Border Background="#064E3B" Padding="12,8" Margin="0,0,0,16" CornerRadius="4"
                                Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVis}}">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#A7F3D0" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                        </Border>
                        <Border Background="#7F1D1D" Padding="12,8" Margin="0,0,0,16" CornerRadius="4"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVis}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FECACA" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" />
                        </Border>

                        <!-- Barcode Fast-Scan Row -->
                        <TextBlock Text="FAST PRODUCT LOOKUP (BARCODE / SKU)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding BarcodeInput, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Tag="Scan barcode or enter SKU..." />
                            <Button Grid.Column="1" Content="Lookup" Command="{Binding BarcodeLookupCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Padding="16,8" />
                        </Grid>

                        <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,0,0,16" />

                        <!-- Select Product Dropdown -->
                        <TextBlock Text="SELECT PRODUCT *" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                                  DisplayMemberPath="Name" Margin="0,0,0,16"
                                  Style="{StaticResource ModernComboBoxStyle}" Height="36" />

                        <!-- Adjustment Type & Date -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="ADJUSTMENT TYPE *" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding AdjustmentTypes}" SelectedItem="{Binding SelectedAdjustmentType}"
                                          Style="{StaticResource ModernComboBoxStyle}" Height="36" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ADJUSTMENT DATE" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                <DatePicker SelectedDate="{Binding AdjustmentDate}" Margin="0,0,0,0" Padding="6,4" />
                            </StackPanel>
                        </Grid>

                        <!-- Quantity & Unit Cost -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="QUANTITY DELTA *" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding AdjustmentQuantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="UNIT COST (PKR)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding CostPerUnit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                            </StackPanel>
                        </Grid>

                        <!-- Reason / Narration Notes -->
                        <TextBlock Text="REASON / NARRATION NOTES *" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20" />

                        <!-- Submit Button -->
                        <Button Content="Confirm &amp; Apply Stock Adjustment" Command="{Binding ConfirmAdjustmentCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}" Height="46" FontSize="15" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Right: Real-time Live Impact Preview -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Stock Impact Preview" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,0,16" />

                    <!-- Product Card -->
                    <Border Background="#0F172A" Padding="14" CornerRadius="6" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="SELECTED PRODUCT" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="{Binding SelectedProduct.Name, FallbackValue='No product selected'}" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,4,0,2" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedProduct.Sku, StringFormat='SKU: {0}', FallbackValue='SKU: -'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding SelectedProduct.CategoryName, StringFormat='Category: {0}', FallbackValue='Category: -'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Current Stock -->
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Current Stock on Hand:" Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CurrentStockPreview, StringFormat='{}{0:N0} Units'}" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- Adjustment Type & Operation -->
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Adjustment Type:" Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedAdjustmentType}" Foreground="#FBBF24" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- Quantity Changed -->
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="Quantity Delta:" Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding AdjustmentQuantity, StringFormat='{}{0:N0} Units'}" Foreground="#38BDF8" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" />
                    </Grid>

                    <Separator Background="{StaticResource BorderDarkBrush}" Margin="0,8,0,16" />

                    <!-- Resulting Stock Impact Card -->
                    <Border Background="#1E293B" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" Padding="16" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="RESULTING INVENTORY LEVEL" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" />
                            <TextBlock Text="{Binding NewStockPreview, StringFormat='{}{0:N0} Units'}" Foreground="#34D399" FontSize="26" FontWeight="Bold" Margin="0,6,0,0" />
                            <TextBlock Text="Atomic SyncQueue and offline database ledger update guaranteed." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
