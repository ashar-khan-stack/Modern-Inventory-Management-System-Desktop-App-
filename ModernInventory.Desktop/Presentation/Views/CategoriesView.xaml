<UserControl x:Class="ModernInventory.Desktop.Presentation.Views.CategoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:ModernInventory.Desktop.Presentation.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="650" d:DesignWidth="1000">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BooleanToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Actions Bar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Category Management" Foreground="White" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Organize products into hierarchical inventory groups" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Search Input -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBoxStyle}" Tag="Search categories..." />
                    <Button Content="Search" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Padding="12,8" />
                    <Button Content="Clear" Command="{Binding ClearSearchCommand}" Background="#334155" Foreground="White" Margin="6,0,0,0" Padding="10,8" BorderThickness="0" Cursor="Hand" />
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 Refresh" Command="{Binding RefreshCommand}" Background="#334155" Foreground="White" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                    <Button Content="+ Add Category" Command="{Binding OpenAddCategoryCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <!-- Optional Drawer/Editor Side Column -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Categories Data Table -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <!-- Status / Error Banner -->
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <Border Background="#064E3B" Padding="12,8" Margin="8,8,8,0" CornerRadius="4"
                                Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVis}}">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#A7F3D0" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                        <Border Background="#7F1D1D" Padding="12,8" Margin="8,8,8,0" CornerRadius="4"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVis}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FECACA" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                    </StackPanel>

                    <!-- Data Grid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" RowBackground="#1E293B" AlternatingRowBackground="#0F172A"
                              Foreground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                              HeadersVisibility="Column" ColumnHeaderHeight="40" RowHeight="44" Margin="8">
                        
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#111827" />
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#334155" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Category Name" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold" Foreground="White" />
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="3*" Foreground="{StaticResource TextMutedBrush}" />
                            <DataGridTextColumn Header="Products Count" Binding="{Binding ProductCount}" Width="1.2*" Foreground="#38BDF8" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt, StringFormat=\{0:yyyy-MM-dd\}}" Width="1.5*" Foreground="{StaticResource TextMutedBrush}" />
                            
                            <!-- Action Buttons Column -->
                            <DataGridTemplateColumn Header="Actions" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Edit" Command="{Binding DataContext.OpenEditCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" Background="#3B82F6" Foreground="White" Padding="8,4" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand" />
                                            <Button Content="Delete" Command="{Binding DataContext.DeleteCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" Background="#EF4444" Foreground="White" Padding="8,4" BorderThickness="0" Cursor="Hand" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Inline Category Editor Drawer -->
            <Border Grid.Column="1" Width="360" Margin="16,0,0,0" Style="{StaticResource CardBorderStyle}"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBlock Text="{Binding EditorTitle}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Content="✕" Command="{Binding CloseEditorCommand}" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0" FontSize="14" Cursor="Hand" />
                    </Grid>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <Border Background="#7F1D1D" Padding="10,6" Margin="0,0,0,12" CornerRadius="4"
                                Visibility="{Binding EditorErrorMessage, Converter={StaticResource StringNotEmptyToVis}}">
                            <TextBlock Text="{Binding EditorErrorMessage}" Foreground="#FECACA" FontSize="12" TextWrapping="Wrap" />
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Cancel" Command="{Binding CloseEditorCommand}" Background="#334155" Foreground="White" Padding="0,10" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand" />
                            <Button Grid.Column="1" Content="Save Category" Command="{Binding SaveCategoryCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Category Name *" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,16" />

                            <TextBlock Text="Description (Optional)" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
