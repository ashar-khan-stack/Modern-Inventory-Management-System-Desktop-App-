<UserControl x:Class="ModernInventory.Desktop.Presentation.Views.POSView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:ModernInventory.Desktop.Presentation.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BooleanToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True" />
        <conv:CurrencyFormatConverter x:Key="CurrencyFormat" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
    </UserControl.Resources>

    <Grid>
        <!-- Main POS Layout -->
        <Grid.RowDefinitions>
            <!-- Top Bar: Barcode Scanner & Quick Info -->
            <RowDefinition Height="Auto" />
            <!-- Main Content: Left (Product Selector) / Right (Cart & Checkout) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Barcode Scanner & Search Bar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,14" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Point of Sale (POS)" Foreground="White" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Scan barcode or select products to build order" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                </StackPanel>

                <!-- USB Barcode Reader & SKU Input -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🔍" Foreground="#38BDF8" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="BarcodeScannerBox" Width="360" 
                             Text="{Binding ScanInput, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBoxStyle}" 
                             Tag="Scan Barcode (USB Scanner) or Enter SKU / Name..." 
                             KeyDown="BarcodeScannerBox_KeyDown" />
                    <Button Content="Add to Cart" Command="{Binding HandleBarcodeOrSearchCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Padding="14,8" />
                </StackPanel>

                <!-- Right Notifications -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <Border Background="#064E3B" Padding="10,6" CornerRadius="4"
                            Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVis}}">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#A7F3D0" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                    <Border Background="#7F1D1D" Padding="10,6" CornerRadius="4"
                            Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="#FECACA" FontSize="11" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Dual Pane: Product Catalog (Left) + Order Cart (Right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4.2*" />
                <ColumnDefinition Width="5.8*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Quick Product Catalog -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#111827" Padding="14,10" CornerRadius="8,8,0,0">
                        <Grid>
                            <TextBlock Text="Product Catalog" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding QuickProducts.Count, StringFormat='{}{0} Available'}" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                        </Grid>
                    </Border>

                    <!-- Product Items Grid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding QuickProducts}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" RowBackground="#1E293B" AlternatingRowBackground="#0F172A"
                              Foreground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                              HeadersVisibility="Column" ColumnHeaderHeight="34" RowHeight="38" Margin="6">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#111827" />
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="8,0" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#334155" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="1*" Foreground="#94A3B8" />
                            <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold" Foreground="White" />
                            <DataGridTextColumn Header="Price" Binding="{Binding SalePrice, Converter={StaticResource CurrencyFormat}}" Width="1.2*" Foreground="#FBBF24" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity, StringFormat='{}{0:N0}'}" Width="0.9*" Foreground="#38BDF8" FontWeight="Bold" />

                            <!-- Add Button Column -->
                            <DataGridTemplateColumn Header="Action" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="+ Add" Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Style="{StaticResource PrimaryButtonStyle}" Padding="6,2" FontSize="11" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- RIGHT: Active Cart & Checkout Panel -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Cart Header & Customer Selection -->
                        <RowDefinition Height="Auto" />
                        <!-- Cart Items Table -->
                        <RowDefinition Height="*" />
                        <!-- Financial Summary & Checkout -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Cart Header & Customer Selection -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Customer Selector -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Customer / Khata Account" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                                      DisplayMemberPath="Name" Background="#0F172A" Foreground="White" Padding="8,6" />
                        </StackPanel>

                        <!-- Clear Cart Button -->
                        <Button Grid.Column="1" Content="Clear Cart" Command="{Binding ClearCartCommand}" 
                                Background="#374151" Foreground="#EF4444" FontWeight="SemiBold" 
                                Padding="10,6" Margin="12,18,0,0" BorderThickness="0" Cursor="Hand" />
                    </Grid>

                    <!-- Cart Items Table -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CartItems}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="#0F172A" BorderThickness="1" BorderBrush="#334155" RowBackground="#1E293B" AlternatingRowBackground="#0F172A"
                              Foreground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                              HeadersVisibility="Column" ColumnHeaderHeight="34" RowHeight="38">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item" Binding="{Binding ProductName}" Width="2*" FontWeight="SemiBold" Foreground="White" />
                            <DataGridTextColumn Header="Price" Binding="{Binding UnitPrice, Converter={StaticResource CurrencyFormat}}" Width="1.1*" Foreground="#CBD5E1" />
                            
                            <!-- Qty with - / + buttons -->
                            <DataGridTemplateColumn Header="Qty" Width="1.3*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="-" Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Background="#334155" Foreground="White" Width="20" Height="20" Padding="0" BorderThickness="0" />
                                            <TextBlock Text="{Binding Quantity, StringFormat='{}{0:N0}'}" Foreground="#38BDF8" FontWeight="Bold" Margin="6,2" VerticalAlignment="Center" />
                                            <Button Content="+" Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Background="#334155" Foreground="White" Width="20" Height="20" Padding="0" BorderThickness="0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Tax (18%)" Binding="{Binding TaxAmount, Converter={StaticResource CurrencyFormat}}" Width="1.1*" Foreground="{StaticResource TextMutedBrush}" />
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, Converter={StaticResource CurrencyFormat}}" Width="1.2*" FontWeight="Bold" Foreground="#34D399" />

                            <!-- Remove item button -->
                            <DataGridTemplateColumn Header="" Width="36">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="✕" Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" Background="Transparent" Foreground="#EF4444" FontWeight="Bold" BorderThickness="0" Cursor="Hand" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Financial Summary & Checkout -->
                    <Border Grid.Row="2" Background="#111827" Padding="14,12" Margin="0,10,0,0" CornerRadius="8">
                        <StackPanel>
                            <!-- Row 1: Payment Method, Order Discount -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Payment Method" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,2" />
                                    <ComboBox ItemsSource="{Binding AvailablePaymentMethods}" SelectedItem="{Binding SelectedPaymentMethod}"
                                              Background="#0F172A" Foreground="White" Padding="6,4" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Order Discount (PKR)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding OrderDiscount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Padding="6,4" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 2: Subtotal, Tax, Grand Total -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Subtotal" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                    <TextBlock Text="{Binding Subtotal, Converter={StaticResource CurrencyFormat}}" Foreground="White" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="GST Tax Amount" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                    <TextBlock Text="{Binding TotalTax, Converter={StaticResource CurrencyFormat}}" Foreground="#FBBF24" FontSize="14" FontWeight="SemiBold" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="GRAND TOTAL" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding GrandTotal, Converter={StaticResource CurrencyFormat}}" Foreground="#34D399" FontSize="18" FontWeight="Bold" />
                                </StackPanel>
                            </Grid>

                            <!-- Row 3: Paid Amount & Change / Due Balance -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Paid by Customer (PKR)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,2" />
                                    <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Padding="6,4" FontWeight="Bold" Foreground="#38BDF8" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding ChangeOrDueLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,2" />
                                    <TextBlock Text="{Binding ChangeOrDueAmount, Converter={StaticResource CurrencyFormat}}" FontSize="16" FontWeight="Bold" Foreground="#F87171" Margin="0,4,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- Checkout Button -->
                            <Button Content="⚡ Complete Sale &amp; Generate Invoice" Command="{Binding CheckoutCommand}" 
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="16,12" FontSize="15" FontWeight="Bold" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Invoice Receipt Modal -->
        <Grid Grid.Row="0" Grid.RowSpan="2" Background="#CC000000"
              Visibility="{Binding IsReceiptOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="650" MaxHeight="600" Style="{StaticResource CardBorderStyle}" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Receipt Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="Tax Invoice / Sales Receipt" Foreground="White" FontSize="20" FontWeight="Bold" />
                            <TextBlock Text="{Binding CompletedSale.InvoiceNumber, StringFormat='{}Invoice Number: {0}'}" Foreground="#38BDF8" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding CompletedSale.SaleDate, StringFormat='{}Date: {0:yyyy-MM-dd HH:mm}'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            <TextBlock Text="{Binding CompletedSale.CustomerName, StringFormat='{}Customer: {0}'}" Foreground="White" FontWeight="SemiBold" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Content="✕" Command="{Binding CloseReceiptCommand}" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0" FontSize="16" Cursor="Hand" />
                    </Grid>

                    <!-- Items Table -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding CompletedSale.Items}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="#0F172A" BorderThickness="1" BorderBrush="#334155" RowBackground="#1E293B" AlternatingRowBackground="#0F172A"
                              Foreground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                              HeadersVisibility="Column" ColumnHeaderHeight="30" RowHeight="32">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Item Description" Binding="{Binding ProductName}" Width="2*" FontWeight="SemiBold" Foreground="White" />
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat='{}{0:N0}'}" Width="0.8*" Foreground="#38BDF8" />
                            <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, Converter={StaticResource CurrencyFormat}}" Width="1.2*" Foreground="#CBD5E1" />
                            <DataGridTextColumn Header="Tax" Binding="{Binding TaxAmount, Converter={StaticResource CurrencyFormat}}" Width="1*" Foreground="{StaticResource TextMutedBrush}" />
                            <DataGridTextColumn Header="Line Total" Binding="{Binding TotalPrice, Converter={StaticResource CurrencyFormat}}" Width="1.3*" FontWeight="Bold" Foreground="#34D399" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Financial Summary -->
                    <Border Grid.Row="2" Background="#111827" Padding="14,10" Margin="0,12,0,0" CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Grand Total" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                <TextBlock Text="{Binding CompletedSale.GrandTotal, Converter={StaticResource CurrencyFormat}}" Foreground="#34D399" FontSize="16" FontWeight="Bold" />
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Amount Paid" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                <TextBlock Text="{Binding CompletedSale.PaidAmount, Converter={StaticResource CurrencyFormat}}" Foreground="#38BDF8" FontSize="16" FontWeight="Bold" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Due Balance" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                                <TextBlock Text="{Binding CompletedSale.DueBalance, Converter={StaticResource CurrencyFormat}}" Foreground="#F87171" FontSize="16" FontWeight="Bold" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Close Receipt" Command="{Binding CloseReceiptCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="20,8" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
