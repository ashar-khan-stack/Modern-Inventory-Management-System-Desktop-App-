<UserControl x:Class="ModernInventory.Desktop.Presentation.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:ModernInventory.Desktop.Presentation.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BooleanToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True" />
        <conv:CurrencyFormatConverter x:Key="CurrencyFormat" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Valuation & Metrics Cards -->
            <RowDefinition Height="Auto" />
            <!-- Filters & Search Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content (Table + Editor Drawer) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Inventory Valuation & Metrics Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Total Products -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="TOTAL PRODUCTS" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="{Binding ValuationSummary.TotalProductCount}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Total Stock Quantity -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,8,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="TOTAL UNITS IN STOCK" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="{Binding ValuationSummary.TotalStockQuantity, StringFormat='{}{0:N0} Units'}" Foreground="#38BDF8" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Inventory Valuation (Cost) -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="8,0,8,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="COST VALUATION (COGS)" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="{Binding ValuationSummary.TotalCostValuation, Converter={StaticResource CurrencyFormat}}" Foreground="#34D399" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Retail Valuation -->
            <Border Grid.Column="3" Style="{StaticResource CardBorderStyle}" Margin="8,0,8,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="RETAIL VALUATION" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="{Binding ValuationSummary.TotalRetailValuation, Converter={StaticResource CurrencyFormat}}" Foreground="#FBBF24" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Low / Out of Stock Alert -->
            <Border Grid.Column="4" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="LOW / REORDER ALERTS" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="{Binding ValuationSummary.LowStockCount, StringFormat='{}{0} Items'}" Foreground="#F87171" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Filters & Actions Bar -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Products &amp; Stock Inventory" Foreground="White" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Real-time SKU, Barcode, Pricing &amp; Stock Management" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                </StackPanel>

                <!-- Center: Filters -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Search Input -->
                    <TextBox Width="240" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBoxStyle}" Tag="Search Name, SKU, Barcode..." />
                    
                    <!-- Category Filter Dropdown -->
                    <ComboBox Width="180" ItemsSource="{Binding Categories}" SelectedValue="{Binding SelectedCategoryId}"
                              SelectedValuePath="Id" DisplayMemberPath="Name" Margin="8,0,0,0"
                              Style="{StaticResource ModernComboBoxStyle}" Height="36" />

                    <!-- Low Stock Filter Toggle -->
                    <CheckBox Content="Low Stock Only" IsChecked="{Binding ShowLowStockOnly}" Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0" />

                    <Button Content="Filter" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="12,0,0,0" Padding="12,6" />
                    <Button Content="Clear" Command="{Binding ClearSearchCommand}" Background="#334155" Foreground="White" Margin="6,0,0,0" Padding="10,6" BorderThickness="0" Cursor="Hand" />
                </StackPanel>

                <!-- Right: Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 Refresh" Command="{Binding RefreshCommand}" Background="#334155" Foreground="White" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                    <Button Content="+ Add Product" Command="{Binding OpenAddProductCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Main DataGrid & Editor Drawer -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Table Container -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Notifications -->
                    <StackPanel Grid.Row="0">
                        <Border Background="#064E3B" Padding="12,8" Margin="8,8,8,0" CornerRadius="4"
                                Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVis}}">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#A7F3D0" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                        <Border Background="#7F1D1D" Padding="12,8" Margin="8,8,8,0" CornerRadius="4"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVis}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FECACA" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                    </StackPanel>

                    <!-- Data Grid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" RowBackground="#1E293B" AlternatingRowBackground="#0F172A"
                              Foreground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                              HeadersVisibility="Column" ColumnHeaderHeight="38" RowHeight="42" Margin="8">
                        
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#111827" />
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#334155" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="1.1*" Foreground="#94A3B8" />
                            <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="1.2*" Foreground="#CBD5E1" />
                            <DataGridTextColumn Header="Product Name" Binding="{Binding Name}" Width="2.2*" FontWeight="SemiBold" Foreground="White" />
                            <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="1.4*" Foreground="{StaticResource TextMutedBrush}" />
                            <DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="0.8*" Foreground="{StaticResource TextMutedBrush}" />
                            <DataGridTextColumn Header="Cost Price" Binding="{Binding CostPrice, Converter={StaticResource CurrencyFormat}}" Width="1.3*" Foreground="#34D399" />
                            <DataGridTextColumn Header="Sale Price" Binding="{Binding SalePrice, Converter={StaticResource CurrencyFormat}}" Width="1.3*" Foreground="#FBBF24" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity, StringFormat='{}{0:N0}'}" Width="1*" FontWeight="Bold" Foreground="#38BDF8" />
                            <DataGridTextColumn Header="Min Alert" Binding="{Binding MinStockAlert, StringFormat='{}{0:N0}'}" Width="0.9*" Foreground="{StaticResource TextMutedBrush}" />
                            <DataGridTextColumn Header="Tax %" Binding="{Binding TaxRate, StringFormat='{}{0:N0}%'}" Width="0.8*" Foreground="{StaticResource TextMutedBrush}" />
                            <DataGridTextColumn Header="Valuation" Binding="{Binding StockValue, Converter={StaticResource CurrencyFormat}}" Width="1.4*" Foreground="White" />

                            <!-- Status Badge -->
                            <DataGridTemplateColumn Header="Status" Width="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#064E3B" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                            <Setter Property="Background" Value="#7F1D1D" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#A7F3D0" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLowStock}" Value="True">
                                                                <Setter Property="Foreground" Value="#FECACA" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions Column -->
                            <DataGridTemplateColumn Header="Actions" Width="210">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Edit" Command="{Binding DataContext.OpenEditProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" Background="#3B82F6" Foreground="White" Padding="6,3" Margin="0,0,4,0" FontSize="11" BorderThickness="0" Cursor="Hand" />
                                            <Button Content="Adjust" Command="{Binding DataContext.NavigateToStockAdjustmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" Background="#D97706" Foreground="White" Padding="6,3" Margin="0,0,4,0" FontSize="11" BorderThickness="0" Cursor="Hand" />
                                            <Button Content="History" Command="{Binding DataContext.NavigateToStockHistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" Background="#64748B" Foreground="White" Padding="6,3" Margin="0,0,4,0" FontSize="11" BorderThickness="0" Cursor="Hand" />
                                            <Button Content="✕" Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" Background="#EF4444" Foreground="White" Padding="6,3" FontSize="11" BorderThickness="0" Cursor="Hand" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Product Editor Drawer -->
            <Border Grid.Column="1" Width="420" Margin="16,0,0,0" Style="{StaticResource CardBorderStyle}"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
                <DockPanel LastChildFill="True">
                    <!-- Drawer Header -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBlock Text="{Binding EditorTitle}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button Content="✕" Command="{Binding CloseEditorCommand}" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0" FontSize="14" Cursor="Hand" />
                    </Grid>

                    <!-- Drawer Footer Buttons -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                        <Border Background="#7F1D1D" Padding="10,6" Margin="0,0,0,12" CornerRadius="4"
                                Visibility="{Binding EditorErrorMessage, Converter={StaticResource StringNotEmptyToVis}}">
                            <TextBlock Text="{Binding EditorErrorMessage}" Foreground="#FECACA" FontSize="12" TextWrapping="Wrap" />
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Cancel" Command="{Binding CloseEditorCommand}" Background="#334155" Foreground="White" Padding="0,10" Margin="0,0,6,0" BorderThickness="0" Cursor="Hand" />
                            <Button Grid.Column="1" Content="Save Product" Command="{Binding SaveProductCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <!-- Form Content ScrollViewer -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,6,0">
                            <!-- Product Name -->
                            <TextBlock Text="Product Name *" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                            <!-- Category & Unit -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Category" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding Categories}" SelectedValue="{Binding FormCategoryId}"
                                              SelectedValuePath="Id" DisplayMemberPath="Name"
                                              Style="{StaticResource ModernComboBoxStyle}" Height="36" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Unit" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding SupportedUnits}" SelectedItem="{Binding FormUnit}"
                                              Style="{StaticResource ModernComboBoxStyle}" Height="36" />
                                </StackPanel>
                            </Grid>

                            <!-- SKU & Barcode -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="SKU Code" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding FormSku, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Barcode / EAN" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding FormBarcode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <!-- Cost Price & Sale Price -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Cost Price (PKR) *" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding FormCostPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Sale Price (PKR) *" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding FormSalePrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <!-- Tax Rate & Min Stock Alert -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="GST Tax Rate (%)" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding FormTaxRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Min Stock Alert" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding FormMinStockAlert, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                                </StackPanel>
                            </Grid>

                            <!-- Initial Stock (Only for new products) -->
                            <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource InvertedBoolToVis}}" Margin="0,0,0,12">
                                <TextBlock Text="Initial Opening Stock" Foreground="{StaticResource TextMutedBrush}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <TextBox Text="{Binding FormInitialStock, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" />
                                <TextBlock Text="An opening stock addition record will be created automatically." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
