<UserControl x:Class="ModernInventory.Desktop.Presentation.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:ModernInventory.Desktop.Presentation.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BooleanToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True" />
        <conv:CurrencyFormatConverter x:Key="CurrencyFormat" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Metric Summary Cards -->
            <RowDefinition Height="Auto" />
            <!-- Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. Metrics Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Total Staff Count -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,8,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="TOTAL EMPLOYEES" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="{Binding TotalEmployeesCount, StringFormat='{}{0} Staff Members'}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Total Monthly Payroll -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="8,0,8,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="ESTIMATED MONTHLY PAYROLL" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="{Binding TotalMonthlyPayroll, Converter={StaticResource CurrencyFormat}}" Foreground="#38BDF8" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Advance Balances Outstanding -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="8,0,0,0" Padding="14,10">
                <StackPanel>
                    <TextBlock Text="PENDING SALARY ADVANCES" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="{Binding TotalAdvanceBalances, Converter={StaticResource CurrencyFormat}}" Foreground="#FBBF24" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 2. Search & Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Staff &amp; Human Resources" Foreground="White" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Employee payroll profiles, designations &amp; salary advances" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                </StackPanel>

                <!-- Center Filters -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBox Width="260" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBoxStyle}" Tag="Search Name, Designation, CNIC..." />
                    <CheckBox Content="Active Only" IsChecked="{Binding ShowActiveOnly}" Foreground="White" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <Button Content="Filter" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="12,0,0,0" Padding="12,6" />
                    <Button Content="Clear" Command="{Binding ClearSearchCommand}" Background="#334155" Foreground="White" Margin="6,0,0,0" Padding="10,6" BorderThickness="0" Cursor="Hand" />
                </StackPanel>

                <!-- Right Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 Refresh" Command="{Binding RefreshCommand}" Background="#334155" Foreground="White" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                    <Button Content="+ Add Employee" Command="{Binding OpenAddEmployeeCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Table & Drawer -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Table Container -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Notifications -->
                    <StackPanel Grid.Row="0">
                        <Border Background="#064E3B" Padding="12,8" Margin="8,8,8,0" CornerRadius="4"
                                Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVis}}">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="#A7F3D0" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                        <Border Background="#7F1D1D" Padding="12,8" Margin="8,8,8,0" CornerRadius="4"
                                Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVis}}">
                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#FECACA" FontWeight="SemiBold" FontSize="12" />
                        </Border>
                    </StackPanel>

                    <!-- Employees DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}"
                              AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0" RowBackground="#1E293B" AlternatingRowBackground="#0F172A"
                              Foreground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                              HeadersVisibility="Column" ColumnHeaderHeight="38" RowHeight="42" Margin="8">
                        
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#111827" />
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="10,0" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                                <Setter Property="BorderBrush" Value="#334155" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Employee Name" Binding="{Binding Name}" Width="2*" FontWeight="SemiBold" Foreground="White" />
                            <DataGridTextColumn Header="Designation" Binding="{Binding Designation}" Width="1.5*" Foreground="#38BDF8" />
                            <DataGridTextColumn Header="CNIC" Binding="{Binding Cnic}" Width="1.4*" Foreground="#CBD5E1" />
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="1.3*" Foreground="{StaticResource TextMutedBrush}" />
                            <DataGridTextColumn Header="Monthly Salary" Binding="{Binding MonthlySalary, Converter={StaticResource CurrencyFormat}}" Width="1.4*" Foreground="#34D399" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="Advance" Binding="{Binding AdvanceBalance, Converter={StaticResource CurrencyFormat}}" Width="1.2*" Foreground="#FBBF24" />
                            <DataGridTextColumn Header="Joined" Binding="{Binding JoiningDate, StringFormat='{}{0:yyyy-MM-dd}'}" Width="1.1*" Foreground="{StaticResource TextMutedBrush}" />

                            <!-- Status Badge -->
                            <DataGridTemplateColumn Header="Status" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1E3A8A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                            <Setter Property="Background" Value="#374151" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusDisplay}" FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#93C5FD" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Foreground" Value="#9CA3AF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Actions -->
                            <DataGridTemplateColumn Header="Actions" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Edit" Command="{Binding DataContext.OpenEditEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Background="#0284C7" Foreground="White" Padding="8,4" Margin="2,0" BorderThickness="0" FontSize="11" Cursor="Hand" />
                                            <Button Content="Delete" Command="{Binding DataContext.DeleteEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Background="#DC2626" Foreground="White" Padding="8,4" Margin="2,0" BorderThickness="0" FontSize="11" Cursor="Hand" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- Side Drawer for Employee Add / Edit -->
            <Border Grid.Column="1" Width="360" Margin="16,0,0,0" Style="{StaticResource CardBorderStyle}"
                    Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Header -->
                        <Grid Margin="0,0,0,16">
                            <TextBlock Text="{Binding EditorTitle}" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Content="✕" Command="{Binding CloseDrawerCommand}" HorizontalAlignment="Right" Background="Transparent" Foreground="{StaticResource TextMutedBrush}" BorderThickness="0" FontSize="14" Cursor="Hand" />
                        </Grid>

                        <!-- Error in Editor -->
                        <Border Background="#7F1D1D" Padding="10,6" Margin="0,0,0,12" CornerRadius="4"
                                Visibility="{Binding EditorErrorMessage, Converter={StaticResource StringNotEmptyToVis}}">
                            <TextBlock Text="{Binding EditorErrorMessage}" Foreground="#FECACA" FontSize="11" TextWrapping="Wrap" />
                        </Border>

                        <!-- Name -->
                        <TextBlock Text="Full Name *" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                        <!-- Designation -->
                        <TextBlock Text="Designation / Role" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormDesignation, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                        <!-- CNIC -->
                        <TextBlock Text="CNIC Number (e.g. 35201-1234567-1)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormCnic, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                        <!-- Phone -->
                        <TextBlock Text="Phone Number" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                        <!-- Address -->
                        <TextBlock Text="Residential Address" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                        <!-- Monthly Salary -->
                        <TextBlock Text="Monthly Salary (PKR)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormMonthlySalary, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                        <!-- Advance Balance -->
                        <TextBlock Text="Advance Balance (PKR)" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormAdvanceBalance, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,12" />

                        <!-- Active Checkbox -->
                        <CheckBox Content="Currently Active Employee" IsChecked="{Binding FormIsActive}" Foreground="White" Margin="0,4,0,16" />

                        <!-- Buttons -->
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="Cancel" Command="{Binding CloseDrawerCommand}" Background="#334155" Foreground="White" Margin="0,0,6,0" Padding="12,10" BorderThickness="0" Cursor="Hand" />
                            <Button Grid.Column="1" Content="Save Employee" Command="{Binding SaveEmployeeCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
