<UserControl x:Class="ModernInventory.Desktop.Presentation.Views.StockHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:ModernInventory.Desktop.Presentation.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <conv:CurrencyFormatConverter x:Key="CurrencyFormat" />
        <conv:StringNullOrEmptyToVisibilityConverter x:Key="StringNotEmptyToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header & Filters Bar -->
        <Border Grid.Row="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,0,16" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Title -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Stock Movement History" Foreground="White" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Audit log of all inventory modifications, write-offs, and additions" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                </StackPanel>

                <!-- Center: Filters -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Search Input -->
                    <TextBox Width="220" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernTextBoxStyle}" Tag="Search product, SKU, reason..." />
                    
                    <!-- Product Filter Dropdown -->
                    <ComboBox Width="200" ItemsSource="{Binding Products}" SelectedItem="{Binding FilterProduct}"
                              DisplayMemberPath="Name" Margin="8,0,0,0"
                              Background="#0F172A" Foreground="White" Padding="8,6" />

                    <Button Content="Filter" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" Padding="12,6" />
                    <Button Content="Clear" Command="{Binding ClearFilterCommand}" Background="#334155" Foreground="White" Margin="6,0,0,0" Padding="10,6" BorderThickness="0" Cursor="Hand" />
                </StackPanel>

                <!-- Right: Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 Refresh" Command="{Binding RefreshCommand}" Background="#334155" Foreground="White" Padding="12,8" Margin="0,0,8,0" BorderThickness="0" Cursor="Hand" />
                    <Button Content="+ New Adjustment" Command="{Binding NavigateToStockAdjustmentCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Data Grid History View -->
        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#7F1D1D" Padding="12,8" Margin="8,8,8,0" CornerRadius="4"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyToVis}}">
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#FECACA" FontWeight="SemiBold" FontSize="12" />
                </Border>

                <DataGrid Grid.Row="1" ItemsSource="{Binding History}"
                          AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" RowBackground="#1E293B" AlternatingRowBackground="#0F172A"
                          Foreground="White" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#334155"
                          HeadersVisibility="Column" ColumnHeaderHeight="38" RowHeight="42" Margin="8">
                    
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#111827" />
                            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#334155" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date &amp; Time" Binding="{Binding AdjustmentDate, StringFormat=\{0:yyyy-MM-dd HH:mm\}}" Width="1.5*" Foreground="{StaticResource TextMutedBrush}" />
                        <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="2.2*" FontWeight="SemiBold" Foreground="White" />
                        <DataGridTextColumn Header="SKU" Binding="{Binding Sku}" Width="1.1*" Foreground="#94A3B8" />
                        <DataGridTextColumn Header="Adjustment Type" Binding="{Binding TypeDisplay}" Width="1.8*" Foreground="#FBBF24" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Prev Stock" Binding="{Binding PreviousQuantity, StringFormat='{}{0:N0}'}" Width="1*" Foreground="{StaticResource TextMutedBrush}" />
                        <DataGridTextColumn Header="Delta" Binding="{Binding QuantityChanged, StringFormat='{}{0:N0}'}" Width="1*" FontWeight="Bold" Foreground="#38BDF8" />
                        <DataGridTextColumn Header="New Stock" Binding="{Binding NewQuantity, StringFormat='{}{0:N0}'}" Width="1*" FontWeight="Bold" Foreground="#34D399" />
                        <DataGridTextColumn Header="Unit Cost" Binding="{Binding CostPerUnit, Converter={StaticResource CurrencyFormat}}" Width="1.3*" Foreground="{StaticResource TextMutedBrush}" />
                        <DataGridTextColumn Header="Reason / Narration" Binding="{Binding Reason}" Width="2.5*" Foreground="{StaticResource TextMutedBrush}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
