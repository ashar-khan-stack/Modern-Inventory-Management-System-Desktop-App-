<Window x:Class="ModernInventory.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ModernInventory.Desktop.Presentation.ViewModels"
        xmlns:views="clr-namespace:ModernInventory.Desktop.Presentation.Views"
        xmlns:conv="clr-namespace:ModernInventory.Desktop.Presentation.Converters"
        mc:Ignorable="d"
        Title="Modern Inventory Management System - Pakistan Edition" 
        Height="800" Width="1280"
        MinHeight="700" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}">

    <Window.Resources>
        <conv:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:BooleanToVisibilityConverter x:Key="InvertedBoolToVis" Invert="True" />
        <conv:EqualityToBooleanConverter x:Key="EqualityToBoolConverter" />

        <!-- DataTemplates for ViewModels -->
        <DataTemplate DataType="{x:Type vm:LoginViewModel}">
            <views:LoginView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegisterViewModel}">
            <views:RegisterView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ForgotPasswordViewModel}">
            <views:ForgotPasswordView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BackupSyncViewModel}">
            <views:BackupSyncView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CategoriesViewModel}">
            <views:CategoriesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockAdjustmentViewModel}">
            <views:StockAdjustmentView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StockHistoryViewModel}">
            <views:StockHistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <views:CustomersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EmployeesViewModel}">
            <views:EmployeesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SuppliersViewModel}">
            <views:SuppliersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchasesViewModel}">
            <views:PurchasesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:POSViewModel}">
            <views:POSView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalesViewModel}">
            <views:SalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AccountingViewModel}">
            <views:AccountingView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- Unauthenticated Auth Screen Layout -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource InvertedBoolToVis}}">
            <ContentControl Content="{Binding CurrentView}" />
        </Grid>

        <!-- Authenticated Main Dashboard Application Layout -->
        <Grid Visibility="{Binding IsAuthenticated, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Modern Sidebar -->
            <Border Grid.Column="0" Background="#111827" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,1,0">
                <DockPanel LastChildFill="True">
                    <!-- Business Header & Logo -->
                    <StackPanel DockPanel.Dock="Top" Margin="20,24,20,20">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="36" Background="{StaticResource PrimaryBrush}" CornerRadius="8" Margin="0,0,12,0">
                                <TextBlock Text="MI" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding BusinessName}" Foreground="White" FontWeight="Bold" FontSize="15" TextTrimming="CharacterEllipsis" MaxWidth="160" />
                                <TextBlock Text="Desktop Edition" Foreground="{StaticResource TextMutedBrush}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                        <Separator Margin="0,16,0,0" Background="{StaticResource BorderDarkBrush}" />
                    </StackPanel>

                    <!-- Bottom User & Sync Status Panel -->
                    <Border DockPanel.Dock="Bottom" Background="#1E293B" Padding="16" Margin="12,0,12,12" CornerRadius="8">
                        <StackPanel>
                            <!-- User info -->
                            <TextBlock Text="{Binding UserFullName}" Foreground="White" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="{Binding UserEmail}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,8" />
                            
                            <!-- Sync Queue Badge -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Background="{StaticResource PrimaryBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="Local DB Ready" Foreground="White" FontSize="10" FontWeight="SemiBold" />
                                </Border>
                                <TextBlock Text="{Binding PendingSyncCount, StringFormat='Queue: {0}'}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                            </StackPanel>

                            <Button Content="Sign Out" Command="{Binding LogoutCommand}" Background="#334155" Foreground="White" Padding="8,4" FontSize="12" BorderThickness="0" Cursor="Hand" />
                        </StackPanel>
                    </Border>

                    <!-- Navigation Items -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="12,0">
                            <Button Content="📊  Dashboard" Command="{Binding NavigateToDashboardCommand}" 
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Tag="{Binding ActiveSection, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=Dashboard}" />

                            <Separator Margin="0,8" Background="{StaticResource BorderDarkBrush}" />
                            <TextBlock Text="INVENTORY &amp; STOCK" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="12,4" />

                            <Button Content="📦  Products &amp; Stock" Command="{Binding NavigateToProductsCommand}" 
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Tag="{Binding ActiveSection, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=Products}" />

                            <Button Content="🏷️  Categories" Command="{Binding NavigateToCategoriesCommand}" 
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Tag="{Binding ActiveSection, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=Categories}" />

                            <Button Content="⚖️  Stock Adjustments" Command="{Binding NavigateToStockAdjustmentsCommand}" 
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Tag="{Binding ActiveSection, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=StockAdjustments}" />

                            <Button Content="📜  Stock Movement History" Command="{Binding NavigateToStockHistoryCommand}" 
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Tag="{Binding ActiveSection, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=StockHistory}" />

                            <Separator Margin="0,8" Background="{StaticResource BorderDarkBrush}" />
                            <TextBlock Text="SYSTEM" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="12,4" />

                            <Button Content="💾  Backup &amp; Sync" Command="{Binding NavigateToBackupSyncCommand}" 
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Tag="{Binding ActiveSection, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=BackupSync}" />

                            <Separator Margin="0,8" Background="{StaticResource BorderDarkBrush}" />
                            <TextBlock Text="POINT OF SALE &amp; SALES" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="12,4" />

                            <Button Content="🛒  Point of Sale (POS)" Command="{Binding NavigateToPOSCommand}" 
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Tag="{Binding ActiveSection, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=POS}" />

                            <Button Content="🧾  Sales &amp; Invoices" Command="{Binding NavigateToSalesCommand}" 
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Tag="{Binding ActiveSection, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=Sales}" />

                            <Separator Margin="0,8" Background="{StaticResource BorderDarkBrush}" />
                            <TextBlock Text="PARTIES &amp; STAKEHOLDERS" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="12,4" />

                            <Button Content="👥  Customers &amp; Khata" Command="{Binding NavigateToCustomersCommand}" 
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Tag="{Binding ActiveSection, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=Customers}" />

                            <Button Content="👔  Staff &amp; Employees" Command="{Binding NavigateToEmployeesCommand}" 
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Tag="{Binding ActiveSection, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=Employees}" />

                            <Separator Margin="0,8" Background="{StaticResource BorderDarkBrush}" />
                            <TextBlock Text="PURCHASES &amp; PAYABLES" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="12,4" />

                            <Button Content="👤  Suppliers" Command="{Binding NavigateToSuppliersCommand}" 
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Tag="{Binding ActiveSection, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=Suppliers}" />

                            <Button Content="🛒  Purchases &amp; Bills" Command="{Binding NavigateToPurchasesCommand}" 
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Tag="{Binding ActiveSection, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=Purchases}" />
                            <Button Content="📒  Accounting &amp; Vouchers" Command="{Binding NavigateToAccountingCommand}" 
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Tag="{Binding ActiveSection, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=Accounting &amp; Vouchers}" />
                            <Button Content="📈  Reports &amp; P&amp;L" Command="{Binding NavigateToReportsCommand}" 
                                    Style="{StaticResource SidebarNavButtonStyle}"
                                    Tag="{Binding ActiveSection, Converter={StaticResource EqualityToBoolConverter}, ConverterParameter=Reports &amp; P&amp;L}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Main Workspace Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="60" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                <Border Grid.Row="0" Background="#111827" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                    <Grid VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ActiveSection}" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                            <Border Background="#064E3B" BorderBrush="{StaticResource PrimaryBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="16,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Offline-First Active" Foreground="#A7F3D0" FontSize="11" FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="Currency: PKR (₨)" Foreground="{StaticResource TextMutedBrush}" FontSize="13" VerticalAlignment="Center" Margin="0,0,20,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dynamic View Area -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentView}" Margin="24" />
            </Grid>
        </Grid>
    </Grid>
</Window>
